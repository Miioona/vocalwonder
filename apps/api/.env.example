NODE_ENV=development
PORT=8000

# Ohne diese Zeile startet der Server, aber ohne Konten.
MONGODB_URI=

# Lange Zufallszeichenkette, signiert die Sitzungen.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Aus der Google Cloud Console (OAuth-Client, Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Aus dem Discord Developer Portal (OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
